# Copy this file to .env and fill in your own values.
# Never commit .env — it is in .gitignore.

# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Model used by the LLM-backed agents
SILVERFILE_MODEL=claude-sonnet-5-5

# SQLite checkpointer file (LangGraph state, resumable sessions)
SILVERFILE_DB_PATH=data/silverfile.sqlite

# MCP tax_math server. With this set, start the server first: python -m src.tax_math.server
# Comment the line out to run the tax math in-process instead (no server needed).
TAX_MATH_MCP_URL=http://localhost:8001/mcp
# Interface the server listens on: 127.0.0.1 (this machine only), or 0.0.0.0 inside Docker
TAX_MATH_MCP_HOST=127.0.0.1

# Bounds for the review -> revise loop and the loop guard
SILVERFILE_MAX_REVIEW_PASSES=3
SILVERFILE_LOOP_GUARD_REPEATS=3

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
